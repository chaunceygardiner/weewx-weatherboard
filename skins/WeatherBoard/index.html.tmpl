##
## index.html -- the readout board.  Its sibling, splitflap.html, shows
## the same station as a split-flap departure board; a tablet shows
## whichever its URL names.  The data, the status line and the expiry live
## in board.inc; the lettering, and the fit to the screen, in readout.inc;
## what goes in each of this page's cells, in index_painter.inc.
#errorCatcher Echo
#encoding UTF-8
#include "title.inc"
<!DOCTYPE html>
<html lang="$gettext('en')">
  <head>
    #include "analytics.inc"
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="apple-touch-icon" href="apple-touch-icon-180x180.png">
    <link rel="stylesheet" type="text/css" href="weatherboard.css?v=$wb_version">
    <title>$wb_tab</title>
    <meta name="description" content="$gettext('Current weather conditions, on a board meant to be read across the room.')">
  </head>
  <body class="readout">
    #include "board.inc"
    #include "readout.inc"
    #include "index_painter.inc"
    <h1 class="ro-title">$wb_title</h1>
    <div class="ro-row ro-top">
      #if $wb_feels
      <section class="ro-panel ro-three" id="ro-temp">
      #else
      <section class="ro-panel" id="ro-temp">
      #end if
        <h2 class="ro-hidden">$gettext("Temperature")</h2>
        <div class="ro-c" id="ro-t" data-empty="--.-"><div class="ro-n"></div><div class="ro-l">$gettext("OUTSIDE") <span class="ro-u">$unit.label.outTemp</span></div></div>
        #if $wb_feels
        <div class="ro-c" id="ro-fl" data-empty="--.-"><div class="ro-n"></div><div class="ro-l">$gettext("FEELS LIKE") <span class="ro-u">$unit.label.appTemp</span></div></div>
        #end if
        <div class="ro-c" id="ro-td" data-empty="--.-"><div class="ro-n"></div><div class="ro-l">$gettext("DEW POINT") <span class="ro-u">$unit.label.dewpoint</span></div></div>
      </section>
    </div>
    <div class="ro-row">
      <section class="ro-panel" id="ro-wind">
        <h2 class="ro-hidden">$gettext("Wind")</h2>
        <div class="ro-c" id="ro-w" data-empty="-- ---"><div class="ro-n"></div><div class="ro-l">$gettext("WIND") <span class="ro-u">$unit.label.windSpeed</span></div></div>
        <div class="ro-c" id="ro-g" data-empty="--"><div class="ro-n"></div><div class="ro-l">$gettext("GUST 10M")</div></div>
        <div class="ro-c" id="ro-gd" data-empty="--"><div class="ro-n"></div><div class="ro-l">$gettext("PEAK TODAY")</div></div>
      </section>
      <section class="ro-panel" id="ro-baro">
        <h2 class="ro-hidden">$gettext("Barometer")</h2>
        <div class="ro-c" id="ro-b" data-empty="--.---"><div class="ro-n"></div><div class="ro-l">$gettext("BAROMETER") <span class="ro-u">$unit.label.barometer</span></div></div>
      </section>
    </div>
    <div class="ro-row">
      <section class="ro-panel" id="ro-rain">
        <h2 class="ro-hidden">$gettext("Rain")</h2>
        <div class="ro-c" id="ro-rd" data-empty="-.--"><div class="ro-n"></div><div class="ro-l">$gettext("RAIN TODAY") <span class="ro-u">$unit.label.rain</span></div></div>
        <div class="ro-c" id="ro-r24" data-empty="-.--"><div class="ro-n"></div><div class="ro-l">$gettext("RAIN 24H") <span class="ro-u">$unit.label.rain</span></div></div>
        <div class="ro-c" id="ro-rr" data-empty="-.--"><div class="ro-n"></div><div class="ro-l">$gettext("RATE") <span class="ro-u">$unit.label.rainRate</span></div></div>
      </section>
      #if $wb_uv or $wb_rad
      <section class="ro-panel" id="ro-sun">
        <h2 class="ro-hidden">$gettext("Sun")</h2>
        #if $wb_uv
        <div class="ro-c" id="ro-uv" data-empty="-.-"><div class="ro-n"></div><div class="ro-l">$gettext("UV")</div></div>
        #end if
        #if $wb_rad
        <div class="ro-c" id="ro-rad" data-empty="---"><div class="ro-n"></div><div class="ro-l">$gettext("SUN") <span class="ro-u">$unit.label.radiation</span></div></div>
        #end if
      </section>
      #end if
    </div>
    <div class="ro-row">
      #if $wb_aqi
      <section class="ro-panel" id="ro-air">
        <h2 class="ro-hidden">$gettext("Air quality")</h2>
        <div class="ro-c" id="ro-aqi" data-empty="--"><div class="ro-n"></div><div class="ro-l">$gettext("AIR QUALITY")</div></div>
      </section>
      #end if
      <section class="ro-panel" id="ro-comfort">
        <h2 class="ro-hidden">$gettext("Comfort")</h2>
        <div class="ro-c" id="ro-rh" data-empty="--"><div class="ro-n"></div><div class="ro-l">$gettext("HUMIDITY") <span class="ro-u">$unit.label.outHumidity</span></div></div>
        <div class="ro-c" id="ro-hi" data-empty="--.-"><div class="ro-n"></div><div class="ro-l">$gettext("HIGH TODAY") <span class="ro-u">$unit.label.outTemp</span></div></div>
      </section>
      <section class="ro-panel" id="ro-clock">
        <h2 class="ro-hidden">$gettext("Time")</h2>
        <div class="ro-c" id="ro-clk" data-empty="--:--:--"><div class="ro-n"></div><div class="ro-l" id="ro-date">&nbsp;</div></div>
      </section>
    </div>
    <footer class="ro-foot">WeatherBoard &copy;2019-2026 by John A Kline.</footer>
  </body>
</html>
